# ============================================================================
# INTELLITEST ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` for local execution: cp .env.example .env
# ============================================================================

# Target Environment (qa | staging | prod)
TEST_ENV=qa

# UI Target (SauceDemo E-Commerce Application)
UI_BASE_URL=https://www.saucedemo.com

# REST API Target (Restful-Booker API)
API_BASE_URL=https://restful-booker.herokuapp.com

# Standard UI Credentials (SauceDemo Public Sandbox Credentials)
STANDARD_USER=standard_user
LOCKED_OUT_USER=locked_out_user
PROBLEM_USER=problem_user
USER_PASSWORD=secret_sauce

# REST API Credentials (Restful-Booker Public Sandbox Credentials)
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=password123

# Execution & Browser Settings
HEADLESS=true
SLOW_MO=0
WORKERS=4
RETRIES=0

# AI-Assisted Failure Analysis (Optional - Google Gemini API)
# Set ENABLE_AI_ANALYSIS=true and provide GEMINI_API_KEY to enable AI diagnostics on test failure
ENABLE_AI_ANALYSIS=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
