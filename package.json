{
  "name": "intellitest-automation-framework",
  "version": "1.0.0",
  "description": "IntelliTest – AI-Powered End-to-End (UI + API) Test Automation Framework built with Playwright and TypeScript",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --project=chromium-ui",
    "test:a11y": "npx playwright test tests/ui/accessibility.spec.ts --project=chromium-ui",
    "test:api": "npx playwright test --project=api-tests",
    "test:hybrid": "npx playwright test --project=hybrid-tests",
    "test:headed": "npx playwright test --headed",
    "test:cross-browser": "npx playwright test --project=chromium-ui --project=firefox-ui --project=webkit-ui",
    "report:pw": "npx playwright show-report",
    "report:allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "report:allure:open": "npx allure open allure-report",
    "typecheck": "npx tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "sdet",
    "automation-framework",
    "page-object-model",
    "api-testing",
    "allure-report",
    "gemini-ai"
  ],
  "author": "H K Charan",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.2.0",
    "typescript": "^5.7.2",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.7"
  }
}
